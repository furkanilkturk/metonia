# OS noise
.DS_Store
Thumbs.db
Desktop.ini
*.tmp
*~

# Editor noise
.vscode/
.idea/

# Obsidian local state (kept out of a shareable template)
.obsidian/workspace.json
.obsidian/workspace-mobile.json
.obsidian/cache
.obsidian/graph.json
.obsidian/community-plugins.json
.obsidian/plugins/
.trash/
workspace*.json

# Secrets and environment files — never commit these
.env
.env.*
*.pem
*.key
*.p12

# Node / build artifacts (none are required, but ignore if a user adds them)
node_modules/
dist/
build/
__pycache__/
*.py[cod]
